# Runtime and persistence
TEND_MODE=demo
TEND_BASE_URL=http://localhost:3000
TEND_DB_PATH=./data/tend.db
DEMO_ACCELERATION_FACTOR=1

# Minds — server only. Obtain from https://build.hellominds.ai/
MINDS_MODE=mock
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=
MINDS_REPLY_TIMEOUT_MS=180000

# Custom Skill — server only. Generate a high-entropy value for a deployed API.
TEND_SKILL_API_KEY=
TEND_WORKER_API_KEY=
TEND_SKILL_DEPLOYED=false
TEND_SKILL_EQUIPPED=false
TEND_SKILL_VERIFIED=false

# Discord — worker only. Store real values in ignored .env.local or deployment secrets.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_MOD_CHANNEL_ID=
DISCORD_TEST_SERVER_AUTHORIZED=false
